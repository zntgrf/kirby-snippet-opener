{
  "name": "kirbysnippetopener",
  "displayName": "Kirby Snippet Opener",
  "description": "simplifies the process of navigating and managing snippet templates in Kirby CMS projects",
  "version": "0.1.6",
  "license": "MIT",
  "engines": {
    "vscode": "^1.94.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/zntgrf/kirby-snippet-opener"
  },
  "icon": "images/icon.png",
  "categories": [
    "Other"
  ],
  "author": {
    "name": "sebastian"
  },
  "publisher": "zntgrf",
  "keywords": [
    "snippet",
    "opener",
    "getkirby",
    "kirbycms"
  ],
  "pricing": "Free",
  "activationEvents": [
    "onLanguage:php"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "configuration": {
      "type": "object",
      "title": "Kirby Snippet Opener",
      "properties": {
        "kirbysnippetopener.snippetPaths": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "site/snippets",
            "site/plugins/*/snippets"
          ],
          "description": "Relative paths to snippet folders. Glob patterns like 'site/plugins/*/snippets' are supported."
        },
        "kirbysnippetopener.snippetPath": {
          "type": "string",
          "default": "site/snippets",
          "description": "Deprecated: Use snippetPaths instead.",
          "deprecationMessage": "Use kirbysnippetopener.snippetPaths instead."
        }
      }
    },
    "commands": [
      {
        "command": "kirbysnippetopener.openSnippet",
        "title": "Open Kirby Snippet",
        "enablement": "editorLangId == php"
      },
      {
        "command": "kirbysnippetopener.createSnippetFromSelection",
        "title": "Create Snippet from Selection",
        "enablement": "editorLangId == php"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "kirbysnippetopener.createSnippetFromSelection",
          "when": "editorHasSelection"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src",
    "test": "vitest run",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "1.94.0",
    "@vscode/vsce": "^4.0.0",
    "eslint": "^10.10.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.11"
  }
}
